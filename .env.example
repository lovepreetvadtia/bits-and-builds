# ==========================================
# Bits & Builds — SMTP Configuration
# ==========================================
# Copy this file to .env.local and fill in your credentials.

# SMTP Server Host (e.g., smtp.gmail.com, smtp.hostinger.com, smtp.zoho.com)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# Secure flag (true for port 465, false for port 587)
SMTP_SECURE=true

# SMTP Username / Sender Email
SMTP_USER=your_email@gmail.com

# SMTP Password / Gmail App Password (16-character password generated in Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_PASS=your_16_character_app_password


# Email From Display Header (optional)
SMTP_FROM="Bits & Builds Inquiries" <your_email@gmail.com>

# Target Notification Receiver Email (optional, defaults to SMTP_USER / your_email@gmail.com)
CONTACT_RECEIVER_EMAIL=your_email@gmail.com
